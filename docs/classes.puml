@startuml
class OrderService {
 +checkout(product_id, quantity)
 +pay(order_id, success)
}
class Repository {
 +products()
 +get_order(order_id)
 +create_order(product_id, quantity)
 +settle(order_id, approved, reference)
}
class FakePaymentGateway {
 +charge(order_id, amount_cents, success)
}
class Order {
 +id: int
 +product_id: int
 +quantity: int
 +amount_cents: int
 +status: string
 +payment_reference: string
}
class Product {
 +id: int
 +name: string
 +price_cents: int
 +stock: int
}
OrderService --> Repository
OrderService --> FakePaymentGateway
Repository ..> Order
Repository ..> Product
Order --> Product
@enduml
