rectangle "BRANCHE FONCTIONNELLE\nVision + diagramme UC\nUC4 : payer une commande" as F #DCEAFF
rectangle "BRANCHE TECHNIQUE\nArchitecture en couches\nAPI et simulateur de paiement\nBase SQLite, CI" as T #DDF3E7
rectangle "FUSION : conception UC4\nScénario métier + architecture" as M #FFF0CB
